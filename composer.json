{
    "name": "gblix/laravel-controller-repository-traits",
    "description": "Traits para Controllers de Laravel facilitando uso da lib `prettus/l5-repository`",
    "type": "library",
    "authors": [
        {
            "name": "Stephan de Souza",
            "email": "stephan@gblix.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "lorisleiva/laravel-actions": "^2.8",
        "itsgoingd/clockwork": "^5.2",
        "spatie/laravel-fractal": "^6.3",
        "prettus/l5-repository": "^2.10 || ^4.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.12",
        "spatie/laravel-package-tools": "^1.92",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-0": {
            "Gblix\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gblix\\Tests\\": "test/"
        }
    }
}
